# Configure estes valores em Project > Settings > Environment Variables no Vercel.
# Nunca publique valores reais neste arquivo.
# Use MYSQL_URL OU preencha os campos MYSQL_HOST / MYSQL_USER / etc.

MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=true

# Gere uma chave aleatória longa (mínimo de 32 caracteres).
SESSION_SECRET=
